{
  "permissions": {
    "ask": [
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git tag)",
      "Bash(git tag *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(bump-my-version *)",
      "Agent",
      "Workflow"
    ],
    "deny": [
      "Edit(CLAUDE.md)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit --author*)",
      "Bash(git -c *)",
      "Bash(git config user.*)",
      "Bash(git config core.hooksPath*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/tools/adr-index.js\" --hook",
            "timeout": 30,
            "statusMessage": "Regenerating the ADR index"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c).on('end',()=>{let c='';try{c=JSON.parse(d).tool_input.command||''}catch(e){}if(/--no-verify|-c\\s+user\\.|user\\.(name|email)\\s+\\S|--author|GIT_(AUTHOR|COMMITTER)_|hooksPath\\s+\\S|Co-Authored-By/i.test(c)){console.error('git-guard: command sets commit identity, skips hooks or adds attribution; blocked.');process.exit(2)}})\"",
            "timeout": 10,
            "statusMessage": "Checking the command for identity, hook or attribution changes"
          }
        ]
      }
    ]
  },
  "idleCompaction": false,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false
}
