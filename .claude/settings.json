{
  "permissions": {
    "ask": [
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git tag)",
      "Bash(git tag *)",
      "Bash(git push)",
      "Bash(git push *)"
    ],
    "deny": [
      "Edit(CLAUDE.md)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/tools/adr-index.js\" --hook",
            "timeout": 30,
            "statusMessage": "Regenerating the ADR index"
          }
        ]
      }
    ]
  }
}
